# Give the logged-in user access to the vendor (configuration) interface of the AULA WIN 60 HE only.
# Interfaces 0/1 carry keystrokes and stay root-only.
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ENV{ID_USB_VENDOR_ID}=="2e3c", ENV{ID_USB_MODEL_ID}=="c365", ENV{ID_USB_INTERFACE_NUM}=="02", TAG+="uaccess"
